    clean.includes('district quarterfinal') ||
    clean.includes('section quarterfinal') ||
    clean.includes('sectional semifinal') ||
    clean.includes('regional quarterfinal') ||
    clean.includes('week 10')
  ) {
    return 1;
  }
  if (
    clean.includes('second round') ||
    clean.includes('round of 16') ||
    clean.includes('district final') ||
    clean.includes('section semifinal') ||
    clean.includes('sectional final') ||
    clean.includes('week 11')
  ) {
    return 2;
  }
  if (
    clean.includes('quarterfinal') ||
    clean.includes('regional final') ||
    clean.includes('district championship') ||
    clean.includes('section final') ||
    clean.includes('regional') ||
    clean.includes('week 12')
  ) {
    return 3;
  }
  if (
    clean.includes('semifinal') ||
    clean.includes('semi-state') ||
    clean.includes('uni-dome semifinal') ||
    clean.includes('u.s. bank stadium semifinal') ||
    clean.includes('week 13')
  ) {
    return 4;
  }
  if (
    clean.includes('state final') ||
    clean.includes('championship') ||
    clean.includes('prep bowl') ||
    clean.includes('show-me bowl') ||
    clean.includes('kroger field') ||
    clean.includes('hancock stadium') ||
    clean.includes('uni-dome state final') ||
    clean.includes('ford field') ||
    clean.includes('camp randall') ||
    clean.includes('lucas oil') ||
    clean.includes('canton') ||
    clean.includes('week 14')
  ) {
    return 5;
  }

  return null;
}


