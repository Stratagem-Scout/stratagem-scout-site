export function sanitizePlayoffGameNode<T extends Record<string, any>>(
  node: T,
  state: StateId,
  fallbackRound?: number | string | null
): T {
  if (!node || typeof node !== 'object') return node;

  const isExpansionState = ['IL', 'IA', 'KY', 'MO', 'MN'].includes(state);
  const hasRealScores =
    node.winner_score !== null &&
    node.winner_score !== undefined &&
    node.loser_score !== null &&
    node.loser_score !== undefined &&
    (Number(node.winner_score) > 0 || Number(node.loser_score) > 0);

  if (isExpansionState && (node.status === 'final' || node.is_completed === true) && hasRealScores) {
    return node;
  }

  const roundHint =
    node.round_number ??
    node.round ??
    node.level ??
    node.playoff_round ??
    node.week ??
    fallbackRound ??
    null;

  const isCompletedOk = isValidCompletedPostseasonScore({
    state,
    roundOrWeek: roundHint,
    dateStr: node.date ?? node.game_date ?? null,
    status: node.status ?? (node.is_completed ? 'final' : 'upcoming'),
    winner: node.winner ?? null,
    winnerScore: node.winner_score ?? node.home_score ?? node.score_a ?? null,
    loserScore: node.loser_score ?? node.away_score ?? node.score_b ?? null,
  });

  if (isCompletedOk) {
    return node;
  }

  return {
    ...node,
    winner: null,
    loser: null,
    winner_score: null,
    loser_score: null,
    is_completed: false,
    status: 'upcoming',
  };
}


