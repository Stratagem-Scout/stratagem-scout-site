          const slot1: BracketSlotTeam = {
            team: t1,
            overallSeed: Number(g1?.seed_a || d * 4 + 1),
            districtSeed: 1,
            districtNumber,
            regionNumber,
          };
          const slot4: BracketSlotTeam = {
            team: t4,
            overallSeed: Number(g1?.seed_b || d * 4 + 4),
            districtSeed: 4,
            districtNumber,
            regionNumber,
          };
          const slot2: BracketSlotTeam = {
            team: t2,
            overallSeed: Number(g2?.seed_a || d * 4 + 2),
            districtSeed: 2,
            districtNumber,
            regionNumber,
          };
          const slot3: BracketSlotTeam = {
            team: t3,
            overallSeed: Number(g2?.seed_b || d * 4 + 3),
            districtSeed: 3,
            districtNumber,
            regionNumber,
          };

          // Record Round 1 official results if final
          const applyGameResult = (
            gameObj: any,
            teamA: Team,
            teamB: Team,
            roundNum: number,
            matchupId?: string
          ): Team | null => {
            if (!gameObj) return null;
            const isDone =
              gameObj.status === 'final' ||
              gameObj.is_completed === true ||
              (gameObj.winner && Number(gameObj.winner_score) > 0);
            if (!isDone || !gameObj.winner) return null;
            const wClean = sanitizeTeamString(gameObj.winner).toLowerCase();
            const aClean = teamA.name.toLowerCase();
            const bClean = teamB.name.toLowerCase();
            const winnerIsB =
              bClean === wClean || bClean.includes(wClean) || wClean.includes(bClean);
            const winTeam = winnerIsB && aClean !== wClean ? teamB : teamA;
            const loseTeam = winTeam.id === teamA.id ? teamB : teamA;
            const recorded = recordFinalScore(
              finalsMap,
              safeState,
              roundNum,
              winTeam,
              loseTeam,
              gameObj.winner_score,
              gameObj.loser_score
            );
            if (recorded && matchupId) {
              defaultOfficialPicks[matchupId] = winTeam.id;
            }
            return winTeam;
          };

          const w1 = applyGameResult(g1, t1, t4, 1, `r1-d${districtNumber}-g1`);
          const w2 = applyGameResult(g2, t2, t3, 1, `r1-d${districtNumber}-g2`);

          const r2Game = r2GamesRaw[d];
          if (r2Game && w1 && w2) {
            applyGameResult(r2Game, w1, w2, 2, `r2-d${districtNumber}`);
          }

          districtsFromBracket.push({
            districtNumber,
            regionNumber,
            semi1: [slot1, slot4],
            semi2: [slot2, slot3],
            allSlots: [slot1, slot2, slot3, slot4],
          });
        }

        // Also record any completed Round 3 / Round 4 / Round 5 games into finalsMap
        const recordLaterRoundGames = (gamesList: any[], roundNum: number) => {
          for (const g of gamesList) {
            if (!g || !g.winner || !(g.status === 'final' || g.is_completed)) continue;
            const dummyUsed = new Set<string>();
            const ta = resolveBracketTeam(
              g.team_a || g.winner,
              allPodTeams,
              stateTeams,
              safeState,
              clampedDivision,
              dummyUsed,
              fallbackCounter
            );
            const tb = resolveBracketTeam(
              g.team_b || g.loser,
              allPodTeams,
              stateTeams,
              safeState,
              clampedDivision,
              dummyUsed,
              fallbackCounter
            );
            const wClean = sanitizeTeamString(g.winner).toLowerCase();
            const winnerIsB = tb.name.toLowerCase().includes(wClean) || wClean.includes(tb.name.toLowerCase());
            const winTeam = winnerIsB && ta.name.toLowerCase() !== wClean ? tb : ta;
            const loseTeam = winTeam.id === ta.id ? tb : ta;
            recordFinalScore(finalsMap, safeState, roundNum, winTeam, loseTeam, g.winner_score, g.loser_score);
          }
        };
        recordLaterRoundGames(r3GamesRaw, 3);
        recordLaterRoundGames(r4GamesRaw, 4);
        recordLaterRoundGames(r5GamesRaw, 5);

        const sortedQuals = [...allPodTeams].sort((a, b) => (hasHigherPPA(a, b) ? -1 : 1));
        const bracketResult: PlayoffSlateBuildResult = {
          clampedDivision,
          divisionTeams: divisionTeams.length > 0 ? divisionTeams : sortedQuals,
          qualifiers32: sortedQuals,
          districts: districtsFromBracket,
          defaultOfficialPicks,
          findOfficialFinal,
        };
        setInMemoryObjectCache(slateCacheKey, bracketResult);
        return bracketResult;
      }

      // Fallback when division has fewer than 8 R1 games (e.g. 16-team class): use real resolvedQualifiers Cycled, never "Seed #X"
      const top32: Team[] = [...resolvedQualifiers.slice(0, 32)];
      while (top32.length < 32 && resolvedQualifiers.length > 0) {
        top32.push(resolvedQualifiers[top32.length % resolvedQualifiers.length]);
      }
      while (top32.length < 32) {
        top32.push(
          createSyntheticTeam(
            `${clampedDivision} Qualifier #${top32.length + 1}`,
            safeState,
            clampedDivision,
            top32.length + 1
          )
        );
      }

      const snakeBuckets: number[][] = [
        [0, 15, 16, 31],
        [7, 8, 23, 24],
        [3, 12, 19, 28],
        [4, 11, 20, 27],
        [1, 14, 17, 30],
        [6, 9, 22, 25],
        [2, 13, 18, 29],
        [5, 10, 21, 26],
      ];

      const districtsGen: DistrictPodGroup[] = [];
      for (let d = 0; d < 8; d++) {
        const districtNumber = d + 1;
        const regionNumber = Math.floor(d / 2) + 1;
        const b = snakeBuckets[d];
        const t1 = top32[b[0]];
        const t2 = top32[b[1]];
        const t3 = top32[b[2]];
        const t4 = top32[b[3]];

        const slot1: BracketSlotTeam = {
          team: t1,
          overallSeed: b[0] + 1,
          districtSeed: 1,
          districtNumber,
          regionNumber,
        };
        const slot4: BracketSlotTeam = {
          team: t4,
          overallSeed: b[3] + 1,
          districtSeed: 4,
          districtNumber,
          regionNumber,
        };
        const slot2: BracketSlotTeam = {
          team: t2,
          overallSeed: b[1] + 1,
          districtSeed: 2,
          districtNumber,
          regionNumber,
        };
        const slot3: BracketSlotTeam = {
          team: t3,
          overallSeed: b[2] + 1,
          districtSeed: 3,
          districtNumber,
          regionNumber,
        };

        const r1g1Hit = findDateScopedPlayoffFinal(t1, t4, safeState, 1, verifiedScores);
        if (r1g1Hit) {
          defaultOfficialPicks[`r1-d${districtNumber}-g1`] = r1g1Hit.winnerId;
        }
        const r1g2Hit = findDateScopedPlayoffFinal(t2, t3, safeState, 1, verifiedScores);
        if (r1g2Hit) {
          defaultOfficialPicks[`r1-d${districtNumber}-g2`] = r1g2Hit.winnerId;
        }

        const w1 = r1g1Hit ? (r1g1Hit.winnerId === t1.id ? t1 : t4) : null;
        const w2 = r1g2Hit ? (r1g2Hit.winnerId === t2.id ? t2 : t3) : null;
        if (w1 && w2) {
          const r2Hit = findDateScopedPlayoffFinal(w1, w2, safeState, 2, verifiedScores);
          if (r2Hit) {
            defaultOfficialPicks[`r2-d${districtNumber}`] = r2Hit.winnerId;
          }
        }

        districtsGen.push({
          districtNumber,
          regionNumber,
          semi1: [slot1, slot4],
          semi2: [slot2, slot3],
          allSlots: [slot1, slot2, slot3, slot4],
        });
      }

      const genResult: PlayoffSlateBuildResult = {
        clampedDivision,
        divisionTeams,
        qualifiers32: top32,
        districts: districtsGen,
        defaultOfficialPicks,
        findOfficialFinal,
      };
      setInMemoryObjectCache(slateCacheKey, genResult);
      return genResult;
    }


