export function inferPostseasonRoundNumber(rawRoundOrWeek?: string | number | null): number | null {
  if (typeof rawRoundOrWeek === 'number' && Number.isFinite(rawRoundOrWeek)) {
    return rawRoundOrWeek >= 1 && rawRoundOrWeek <= 6 ? rawRoundOrWeek : null;
  }
  const clean = String(rawRoundOrWeek || '').trim().toLowerCase();
  if (!clean) return null;

  const roundMatch = clean.match(/\b(?:round|level|r)\s*([1-6])\b/);
