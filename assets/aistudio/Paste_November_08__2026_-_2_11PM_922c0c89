          defense_rating: Number(q.defense_rating ?? 17.5),
          sos_index: Number(q.sos_index ?? 70.0),
          playoff_points: Number(q.playoff_points ?? 40.0),
          ppg: Number(q.ppg ?? 30.0),
          pa: Number(q.pa ?? 16.0),
          region: Number(q.region ?? (Math.floor(idx / 8) + 1)),
        });
      });
    });
    if (synthesizedRankings.length > 0) {
      synthesizedRankings.sort((a, b) => Number(b.power_index || 0) - Number(a.power_index || 0));
      synthesizedRankings.forEach((r, idx) => {
        r.rank = idx + 1;
      });
      liveBundle = {
        rankings: synthesizedRankings,
        upcoming_playoff_slate: rawSlateEntries,
      };
    }
  }

  if (rawSlateEntries.length === 0 && liveBundle?.upcoming_playoff_slate) {
    rawSlateEntries = liveBundle.upcoming_playoff_slate;
  }

  const upcomingSlate =
    rawSlateEntries.length > 0
      ? rawSlateEntries.map((entry) =>
          sanitizePlayoffGameNode(entry, st, entry.round_number ?? entry.round)
        )
      : null;

  return {
    liveBundle,
    ratingsRows,
    upcomingSlate,
    bracketsRaw,
    verifiedScores,
    dossiersRaw,
    schoolCoordsMap,
    predictionAudit,
  };
}


