```ts
const ALL_STATE_FOLDERS = [
  'michigan', 'wisconsin', 'ohio', 'indiana',
  'illinois', 'iowa', 'kentucky', 'missouri', 'minnesota',
  'texas', 'florida', 'georgia', 'alabama', 'tennessee', 'louisiana',
  'mississippi', 'arkansas', 'south_carolina', 'north_carolina', 'oklahoma', 'virginia',
];

function syncWorkspaceStateFilesForBuild(rootDir: string, outDirName: string = 'dist') {
  const publicDataDir = path.resolve(rootDir, 'public', 'data');
  const distDataDir = path.resolve(rootDir, outDirName, 'data');
  try {
    fs.mkdirSync(publicDataDir, { recursive: true });
  } catch {}

  for (const folder of ALL_STATE_FOLDERS) {
    const srcFolder = path.resolve(rootDir, folder);
    if (!fs.existsSync(srcFolder) || !fs.statSync(srcFolder).isDirectory()) continue;

    const publicStateFolder = path.resolve(rootDir, 'public', folder);
    const distStateFolder = path.resolve(rootDir, outDirName, folder);
    try {
      fs.mkdirSync(publicStateFolder, { recursive: true });
    } catch {}
    if (fs.existsSync(path.resolve(rootDir, outDirName))) {
      try {
        fs.mkdirSync(distDataDir, { recursive: true });
        fs.mkdirSync(distStateFolder, { recursive: true });
      } catch {}
    }

    for (const file of fs.readdirSync(srcFolder)) {
      if (!file.endsWith('.json') && !file.endsWith('.csv')) continue;
      const srcFile = path.join(srcFolder, file);
      if (!fs.statSync(srcFile).isFile()) continue;
      try {
        fs.copyFileSync(srcFile, path.join(publicDataDir, file));
        fs.copyFileSync(srcFile, path.join(publicStateFolder, file));
        if (fs.existsSync(path.resolve(rootDir, outDirName))) {
          fs.copyFileSync(srcFile, path.join(distDataDir, file));
          fs.copyFileSync(srcFile, path.join(distStateFolder, file));
        }
      } catch {}
    }
  }
}



