      r.list.some((m) => m.slotA?.team && m.slotB?.team && !m.officialFinal)
    );
    if (!activeRoundObj) {
      activeRoundObj = orderedRounds[orderedRounds.length - 1];
    }

    for (const m of activeRoundObj.list) {
      if (!m.slotA?.team || !m.slotB?.team) continue;
      const isComp = Boolean(m.officialFinal);
      const wTeam =
        m.officialFinal?.winnerId === m.slotA.team.id
          ? m.slotA.team
          : m.officialFinal?.winnerId === m.slotB.team.id
          ? m.slotB.team
          : undefined;
      const lTeam =
        wTeam && wTeam.id === m.slotA.team.id
          ? m.slotB.team
          : wTeam
          ? m.slotA.team
