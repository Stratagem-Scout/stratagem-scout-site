  const divs = (STATES_CONFIG[currentState]?.divisions || ['D1']).filter((d) => d !== 'ALL');
  const isWisconsin = currentState === 'WI';
  const generated: UpcomingPlayoffSlateEntry[] = [];

  const roundDates: Record<number, string> = {
    1: 'Oct. 30, 2026',
    2: 'Nov. 6, 2026',
    3: 'Nov. 13, 2026',
    4: 'Nov. 20, 2026',
    5: 'Nov. 27, 2026',
  };

  for (const div of divs) {
    const built = buildPlayoffSlateData(
      teams,
      currentState,
      div,
      verifiedScores,
      stateBracketsRaw,
      stateUpcomingSlate
